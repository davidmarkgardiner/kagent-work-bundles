# Initial FastMCP password path. The Secret must be created by the approved
# secret-delivery system and contain only the configured username/password keys.
apiVersion: v1
kind: Namespace
metadata:
  name: fastmcp-entra-poc
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fastmcp-postgres-entra
  namespace: fastmcp-entra-poc
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: fastmcp-postgres-entra
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fastmcp-postgres-entra
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: fastmcp
          image: "{{FASTMCP_IMAGE}}"
          imagePullPolicy: IfNotPresent
          ports:
            - name: mcp
              containerPort: 8000
          env:
            - name: POSTGRES_AUTH_MODE
              value: password
            - name: POSTGRES_HOST
              value: "{{POSTGRES_HOST}}"
            - name: POSTGRES_DATABASE
              value: "{{POSTGRES_DATABASE}}"
            - name: APPROVED_VIEW
              value: "{{APPROVED_VIEW}}"
            - name: DENIED_BASE_TABLE
              value: "{{DENIED_BASE_TABLE}}"
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: "{{POSTGRES_SECRET_NAME}}"
                  key: "{{POSTGRES_USERNAME_KEY}}"
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: "{{POSTGRES_SECRET_NAME}}"
                  key: "{{POSTGRES_PASSWORD_KEY}}"
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
            readOnlyRootFilesystem: true
          readinessProbe:
            tcpSocket:
              port: mcp
            initialDelaySeconds: 5
            periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: fastmcp-postgres-entra
  namespace: fastmcp-entra-poc
spec:
  selector:
    app.kubernetes.io/name: fastmcp-postgres-entra
  ports:
    - name: mcp
      port: 8000
      targetPort: mcp
