apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: radar
  namespace: "{{RADAR_NAMESPACE}}"
spec:
  interval: 1h
  url: https://skyhook-io.github.io/helm-charts
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: radar-topology
  namespace: "{{RADAR_NAMESPACE}}"
spec:
  interval: 30m
  releaseName: radar-topology
  chart:
    spec:
      chart: radar
      version: "1.15.0"
      sourceRef:
        kind: HelmRepository
        name: radar
      interval: 1h
  values:
{{HELM_VALUES}}
