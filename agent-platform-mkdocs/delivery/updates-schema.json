{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "updates"
  ],
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "scope",
        "reviewed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "documentation",
            "offline",
            "target-runtime",
            "target-service",
            "owner-confirmation"
          ]
        },
        "reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "properties": {
    "updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "published",
          "period",
          "reviewer",
          "summary",
          "achievements",
          "moved",
          "unchanged",
          "next",
          "decisions",
          "scope_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "published": {
            "type": "string",
            "format": "date"
          },
          "period": {
            "type": "object",
            "required": [
              "label",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "end": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "milestone",
                "outcome",
                "why_it_matters",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "milestone": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1
                },
                "why_it_matters": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/evidence"
                  }
                }
              }
            }
          },
          "moved": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "milestone",
                "from",
                "to",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "milestone": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "enum": [
                    "delivered",
                    "in_progress",
                    "proposed",
                    "blocked",
                    "built",
                    "live",
                    "building",
                    "next",
                    "unrecorded"
                  ]
                },
                "to": {
                  "enum": [
                    "delivered",
                    "in_progress",
                    "proposed",
                    "blocked",
                    "built",
                    "live",
                    "building",
                    "next"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unchanged": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "milestone",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "milestone": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "owner",
                "decision"
              ],
              "additionalProperties": false,
              "properties": {
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "decision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
