{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "reviewed_on",
    "cadence",
    "planning_note",
    "focus",
    "next",
    "milestones",
    "calendar"
  ],
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "scope",
        "reviewed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "documentation",
            "offline",
            "target-runtime",
            "target-service",
            "owner-confirmation"
          ]
        },
        "reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "cadence": {
      "type": "string",
      "minLength": 1
    },
    "planning_note": {
      "type": "string",
      "minLength": 1
    },
    "focus": {
      "type": "object",
      "required": [
        "title",
        "state",
        "detail",
        "milestones"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next": {
      "type": "object",
      "required": [
        "title",
        "detail",
        "milestones"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "horizon",
          "title",
          "outcome",
          "state",
          "owner",
          "acceptance",
          "dependencies",
          "evidence",
          "gate",
          "next_action",
          "track",
          "category",
          "window",
          "built_on",
          "live_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "enum": [
              "immediate",
              "q4",
              "q1",
              "history"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "built",
              "live",
              "building",
              "next",
              "blocked"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence"
            }
          },
          "gate": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "minLength": 1
              },
              "unblocks": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "owner",
              "decision",
              "unblocks"
            ],
            "additionalProperties": false
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          },
          "track": {
            "enum": [
              "agents",
              "tools",
              "governance"
            ]
          },
          "category": {
            "enum": [
              "specialists",
              "coordination",
              "mcp",
              "skills",
              "policy",
              "evaluation",
              "observability",
              "sdlc"
            ]
          },
          "window": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$"
          },
          "built_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "live_on": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "historical": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "precision",
              "confirmed_on",
              "confirmed_by",
              "basis"
            ],
            "properties": {
              "period": {
                "type": "string",
                "pattern": "^[0-9]{4}-Q[1-4]$"
              },
              "precision": {
                "const": "approximate-quarter"
              },
              "confirmed_on": {
                "type": "string",
                "format": "date"
              },
              "confirmed_by": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "built",
                    "live"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "built_on": {
                      "type": "string"
                    }
                  }
                },
                {
                  "required": [
                    "historical"
                  ],
                  "properties": {
                    "built_on": {
                      "type": "null"
                    },
                    "evidence": {
                      "contains": {
                        "properties": {
                          "scope": {
                            "const": "owner-confirmation"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "live"
                }
              }
            },
            "then": {
              "properties": {
                "live_on": {
                  "type": "string"
                },
                "evidence": {
                  "contains": {
                    "properties": {
                      "scope": {
                        "const": "target-service"
                      }
                    }
                  }
                },
                "built_on": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "properties": {
                "gate": {
                  "type": "object"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "note",
        "windows"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "quarter",
              "horizon"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2]|Q[1-4])$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "quarter": {
                "type": "string",
                "minLength": 1
              },
              "horizon": {
                "enum": [
                  "immediate",
                  "q4",
                  "q1",
                  "history"
                ]
              }
            }
          }
        }
      }
    }
  }
}
