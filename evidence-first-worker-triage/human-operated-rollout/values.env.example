# Copy to values.env outside Git, then replace placeholders with references/names only.
WORKER_CONTEXT={{WORKER_KUBECTL_CONTEXT}}
MANAGEMENT_CONTEXT={{MANAGEMENT_KUBECTL_CONTEXT}}
WORKER_NAMESPACE={{NON_PRODUCTION_WORKER_NAMESPACE}}
MANAGEMENT_NAMESPACE={{MANAGEMENT_NAMESPACE}}

# Worker runtime discovered from the target cluster / approved GitOps render.
ALLOY_DEPLOYMENT={{ALLOY_DEPLOYMENT_NAME}}
ALLOY_SERVICE_ACCOUNT={{ALLOY_SERVICE_ACCOUNT_NAME}}
ALLOY_EXPECTED_IMAGE={{APPROVED_ALLOY_IMAGE_REFERENCE}}
VECTOR_DEPLOYMENT={{VECTOR_DEPLOYMENT_NAME}}
VECTOR_SERVICE={{VECTOR_SERVICE_NAME}}
VECTOR_BUFFER_PVC={{VECTOR_BUFFER_PVC_NAME_OR_EMPTY}}
VECTOR_EXPECTED_IMAGE={{APPROVED_VECTOR_IMAGE_REFERENCE}}

# Management runtime discovered from the target cluster / approved GitOps render.
EVENTBUS_NAME={{ARGO_EVENTBUS_NAME}}
EVENTSOURCE_NAME={{ARGO_KAFKA_EVENTSOURCE_NAME}}
EVENTSOURCE_LABEL={{DISCOVERED_EVENTSOURCE_POD_LABEL_SELECTOR}}
EVENTSOURCE_EXPECTED_IMAGE={{APPROVED_EVENTSOURCE_IMAGE_REFERENCE_OR_EMPTY}}
SENSOR_NAME={{ARGO_SENSOR_NAME}}
WORKFLOW_TEMPLATE_NAME={{ARGO_WORKFLOW_TEMPLATE_NAME}}
KAGENT_NAMESPACE={{KAGENT_NAMESPACE}}
KAGENT_AGENT_NAME={{READ_ONLY_KAGENT_AGENT_NAME}}
KAGENT_CONTROLLER_DEPLOYMENT={{KAGENT_CONTROLLER_DEPLOYMENT_NAME}}
AKS_MCP_NAMESPACE={{AKS_MCP_NAMESPACE}}
AKS_MCP_LABEL={{DISCOVERED_AKS_MCP_POD_LABEL}}
AKS_MCP_EXPECTED_IMAGE={{APPROVED_AKS_MCP_IMAGE_REFERENCE_OR_EMPTY}}
KAFKA_TOPIC={{APPROVED_CONFLUENT_TOPIC}}
KAFKA_CONSUMER_GROUP={{APPROVED_CONFLUENT_CONSUMER_GROUP}}
