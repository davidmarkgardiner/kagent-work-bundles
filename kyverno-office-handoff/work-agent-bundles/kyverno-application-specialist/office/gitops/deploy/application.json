{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "registry-demo",
    "namespace": "{{DEMO_NAMESPACE}}"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "registry-demo"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "registry-demo"
        },
        "annotations": {
          "demo.kagent.dev/recovery-run": "office-bootstrap"
        }
      },
      "spec": {
        "restartPolicy": "Always",
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "web",
            "image": "docker.io/library/busybox:1.36",
            "command": [
              "sh",
              "-c",
              "mkdir -p /tmp/www && echo recovered > /tmp/www/index.html && exec httpd -f -p 8080 -h /tmp/www"
            ],
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "volumeMounts": [
              {
                "name": "temporary",
                "mountPath": "/tmp"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/",
                "port": 8080
              },
              "periodSeconds": 2
            }
          }
        ],
        "volumes": [
          {
            "name": "temporary",
            "emptyDir": {}
          }
        ],
        "terminationGracePeriodSeconds": 1
      }
    }
  }
}
