{
  "apiVersion": "v1",
  "items": [
    {
      "apiVersion": "v1",
      "data": {
        "config.yaml": "frontendPolicies:\n  tracing:\n    host: flow-collector.agent-flow-demo.svc.cluster.local:4317\n    protocol: grpc\n    randomSampling: 1\n  accessLog:\n    otlp:\n      host: flow-collector.agent-flow-demo.svc.cluster.local:4317\n      protocol: grpc\nbinds:\n- port: 8081\n  listeners:\n  - protocol: HTTP\n    routes:\n    - backends:\n      - ai:\n          name: deepseek-flash\n          provider:\n            openAI:\n              model: deepseek-flash\n          hostOverride: api.deepseek.com:443\n          pathOverride: /chat/completions\n          policies:\n            backendAuth:\n              key: $DEEPSEEK_API_KEY\n            backendTLS: {}\n            ai:\n              overrides:\n                thinking:\n                  type: disabled\n"
      },
      "immutable": true,
      "kind": "ConfigMap",
      "metadata": {
        "labels": {
          "app": "standalone-deepseek-model"
        },
        "name": "standalone-deepseek-model",
        "namespace": "agent-flow-demo"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app": "standalone-deepseek-model"
        },
        "name": "standalone-deepseek-model",
        "namespace": "agent-flow-demo"
      },
      "spec": {
        "progressDeadlineSeconds": 600,
        "replicas": 1,
        "revisionHistoryLimit": 10,
        "selector": {
          "matchLabels": {
            "app": "standalone-deepseek-model"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": "25%",
            "maxUnavailable": "25%"
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "standalone-deepseek-model"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "-f",
                  "/config/config.yaml"
                ],
                "env": [
                  {
                    "name": "DEEPSEEK_API_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "api-key",
                        "name": "standalone-deepseek-model"
                      }
                    }
                  }
                ],
                "image": "cr.agentgateway.dev/agentgateway:v1.7.0@sha256:60216aafb03d37f94e952ff3d51d2f630a65b10ecaebdc0a864882f92610c45b",
                "imagePullPolicy": "IfNotPresent",
                "name": "gateway",
                "ports": [
                  {
                    "containerPort": 8081,
                    "name": "http",
                    "protocol": "TCP"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 3,
                  "periodSeconds": 3,
                  "successThreshold": 1,
                  "tcpSocket": {
                    "port": "http"
                  },
                  "timeoutSeconds": 1
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  },
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "terminationMessagePath": "/dev/termination-log",
                "terminationMessagePolicy": "File",
                "volumeMounts": [
                  {
                    "mountPath": "/config",
                    "name": "config",
                    "readOnly": true
                  }
                ]
              }
            ],
            "dnsPolicy": "ClusterFirst",
            "enableServiceLinks": false,
            "restartPolicy": "Always",
            "schedulerName": "default-scheduler",
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccount": "standalone-deepseek-model",
            "serviceAccountName": "standalone-deepseek-model",
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 420,
                  "name": "standalone-deepseek-model"
                },
                "name": "config"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "labels": {
          "app": "standalone-deepseek-model"
        },
        "name": "standalone-deepseek-model",
        "namespace": "agent-flow-demo"
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 8081,
            "protocol": "TCP",
            "targetPort": 8081
          }
        ],
        "selector": {
          "app": "standalone-deepseek-model"
        },
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "labels": {
          "app": "standalone-deepseek-model"
        },
        "name": "standalone-deepseek-model",
        "namespace": "agent-flow-demo"
      },
      "spec": {
        "egress": [
          {
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              }
            ]
          },
          {
            "ports": [
              {
                "port": 53,
                "protocol": "UDP"
              },
              {
                "port": 53,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ]
          },
          {
            "ports": [
              {
                "port": 4317,
                "protocol": "TCP"
              }
            ],
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app": "flow-collector"
                  }
                }
              }
            ]
          }
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "secure-kro-standalone"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "standalone-secure.platform/role": "facade"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8081,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "podSelector": {
          "matchLabels": {
            "app": "standalone-deepseek-model"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ]
      }
    }
  ],
  "kind": "List",
  "metadata": {
    "resourceVersion": ""
  }
}
