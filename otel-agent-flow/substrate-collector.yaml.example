apiVersion: v1
kind: Namespace
metadata:
  name: otel-agent-flow
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: flow-collector
  namespace: otel-agent-flow
data:
  config.yaml: "receivers:\n  otlp:\n    protocols:\n      grpc:\n        endpoint:\
    \ 0.0.0.0:4317\n      http:\n        endpoint: 0.0.0.0:4318\nprocessors:\n  memory_limiter:\n\
    \    check_interval: 1s\n    limit_mib: 192\n    spike_limit_mib: 48\n  batch:\n\
    \    timeout: 200ms\n    send_batch_size: 64\nexporters:\n  otlp_http/dashboard:\n\
    \    endpoint: http://flow-dashboard:8788\n    encoding: json\n    compression:\
    \ none\n    retry_on_failure:\n      enabled: true\n      max_elapsed_time: 30s\n\
    \  debug/metrics:\n    verbosity: basic\nservice:\n  pipelines:\n    traces:\n\
    \      receivers:\n      - otlp\n      processors:\n      - memory_limiter\n \
    \     - batch\n      exporters:\n      - otlp_http/dashboard\n    logs:\n    \
    \  receivers:\n      - otlp\n      processors:\n      - memory_limiter\n     \
    \ - batch\n      exporters:\n      - otlp_http/dashboard\n    metrics:\n     \
    \ receivers:\n      - otlp\n      processors:\n      - memory_limiter\n      -\
    \ batch\n      exporters:\n      - debug/metrics\n"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flow-collector
  namespace: otel-agent-flow
spec:
  replicas: 1
  selector:
    matchLabels:
      app: flow-collector
  template:
    metadata:
      labels:
        app: flow-collector
    spec:
      automountServiceAccountToken: false
      containers:
      - name: collector
        image: otel/opentelemetry-collector:0.146.0
        args:
        - --config=/config/config.yaml
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            cpu: '1'
            memory: 256Mi
        ports:
        - name: grpc
          containerPort: 4317
        - name: http
          containerPort: 4318
        volumeMounts:
        - name: config
          mountPath: /config
          readOnly: true
      volumes:
      - name: config
        configMap:
          name: flow-collector
---
apiVersion: v1
kind: Service
metadata:
  name: flow-collector
  namespace: otel-agent-flow
spec:
  selector:
    app: flow-collector
  ports:
  - name: grpc
    port: 4317
    targetPort: 4317
  - name: http
    port: 4318
    targetPort: 4318
---
apiVersion: v1
kind: Service
metadata:
  name: flow-dashboard
  namespace: otel-agent-flow
spec:
  ports:
  - name: http
    port: 8788
    targetPort: 8788
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: flow-dashboard-host
  namespace: otel-agent-flow
  labels:
    kubernetes.io/service-name: flow-dashboard
addressType: IPv4
ports:
- name: http
  protocol: TCP
  port: 8788
endpoints:
- addresses:
  - '{{KIND_BRIDGE_ADDRESS}}'
  conditions:
    ready: true
---
apiVersion: v1
kind: Service
metadata:
  name: flow-model
  namespace: otel-agent-flow
spec:
  ports:
  - name: http
    port: 8081
    targetPort: 18081
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: flow-model-host
  namespace: otel-agent-flow
  labels:
    kubernetes.io/service-name: flow-model
addressType: IPv4
ports:
- name: http
  protocol: TCP
  port: 18081
endpoints:
- addresses:
  - '{{KIND_BRIDGE_ADDRESS}}'
  conditions:
    ready: true
