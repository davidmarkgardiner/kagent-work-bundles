{
  "nativeAPI": "kagent.dev/v1alpha2",
  "namespace": "classic-agents",
  "runtime": "go",
  "models": [
    "approved-model"
  ],
  "skills": {
    "work-guidance": {
      "mode": "git",
      "git": {
        "url": "{{APPROVED_GITLAB_SKILLS_REPOSITORY_URL}}",
        "ref": "{{APPROVED_FULL_COMMIT_ID}}",
        "path": "skills/work-guidance",
        "name": "work-guidance"
      }
    }
  },
  "tools": {
    "kubernetes-readonly": {
      "type": "McpServer",
      "mcpServer": {
        "apiGroup": "kagent.dev",
        "kind": "RemoteMCPServer",
        "name": "approved-kubernetes-mcp",
        "toolNames": [
          "k8s_get_resources",
          "k8s_get_events"
        ]
      }
    },
    "gitlab-readonly": {
      "type": "McpServer",
      "mcpServer": {
        "apiGroup": "kagent.dev",
        "kind": "RemoteMCPServer",
        "name": "approved-gitlab-mcp",
        "toolNames": [
          "gitlab_get_project",
          "gitlab_get_latest_pipeline"
        ]
      }
    },
    "denodo-readonly": {
      "type": "McpServer",
      "mcpServer": {
        "apiGroup": "kagent.dev",
        "kind": "RemoteMCPServer",
        "name": "approved-denodo-mcp",
        "toolNames": [
          "get_inventory_data_product_details",
          "get_namespace_count",
          "get_namespace_summary"
        ]
      }
    }
  },
  "gatewayNamespace": "classic-agents",
  "gatewayName": "classic-demo",
  "gatewayClass": "agentgateway",
  "verifyListener": "verify",
  "callerListener": "caller",
  "gatewayPort": 8081,
  "callerPort": 8080,
  "verifyGatewayURL": "http://classic-demo.classic-agents.svc.cluster.local:8081",
  "callerGatewayURL": "http://classic-demo.classic-agents.svc.cluster.local:8080",
  "issuer": "{{KUBERNETES_SERVICE_ACCOUNT_ISSUER}}",
  "jwks": "{{KUBERNETES_JWKS_JSON}}",
  "audience": "secure-agent-classic",
  "verifierImage": "{{APPROVED_GOLDEN_IMAGE_AT_DIGEST}}",
  "dnsEgress": {
    "to": [
      {
        "namespaceSelector": {
          "matchLabels": {
            "kubernetes.io/metadata.name": "kube-system"
          }
        }
      }
    ],
    "ports": [
      {
        "protocol": "UDP",
        "port": 53
      },
      {
        "protocol": "TCP",
        "port": 53
      }
    ]
  },
  "agentEgress": [
    {
      "to": [
        {
          "namespaceSelector": {
            "matchLabels": {
              "kubernetes.io/metadata.name": "kube-system"
            }
          }
        }
      ],
      "ports": [
        {
          "protocol": "UDP",
          "port": 53
        },
        {
          "protocol": "TCP",
          "port": 53
        }
      ]
    },
    {
      "to": [
        {
          "namespaceSelector": {
            "matchLabels": {
              "kubernetes.io/metadata.name": "{{MODEL_GATEWAY_NAMESPACE}}"
            }
          },
          "podSelector": {
            "matchLabels": {
              "app": "{{MODEL_GATEWAY_POD_LABEL}}"
            }
          }
        }
      ],
      "ports": [
        {
          "protocol": "TCP",
          "port": 8081
        }
      ]
    },
    {
      "to": [
        {
          "namespaceSelector": {
            "matchLabels": {
              "kubernetes.io/metadata.name": "{{KAGENT_CONTROLLER_NAMESPACE}}"
            }
          },
          "podSelector": {
            "matchLabels": {
              "app.kubernetes.io/name": "{{KAGENT_CONTROLLER_LABEL}}"
            }
          }
        }
      ],
      "ports": [
        {
          "protocol": "TCP",
          "port": 8083
        }
      ]
    }
  ],
  "gitAuthSecretName": "approved-git-credentials"
}
