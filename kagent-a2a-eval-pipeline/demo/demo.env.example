# Copy to demo/demo.env and fill. Explicit values only; the demo never uses the current kubectl context.
CTX={{KUBE_CONTEXT}}                      # e.g. the lab or a non-production cluster
NS=kagent                                 # where the demo agents and ModelConfigs live
RUN=$HOME/guard-demo-run                  # scratch folder: receipts, findings, ledgers, tickets
A2A_BASE=http://127.0.0.1:18083/agents/kagent      # kagent A2A (1.x path); port-forward or gateway URL
# Gateway route that the Guard may block (demo/lab/guard-demo-route.yaml) and the caller identity it checks
GW_URL=http://127.0.0.1:18090/guard-demo/invoke
GW_ROUTE=guard-demo
GW_CALLER_SA={{CALLER_SERVICE_ACCOUNT}}
GW_CALLER_NS={{CALLER_NAMESPACE}}
GW_AUDIENCE={{JWT_AUDIENCE}}
POLICY_NS={{ROUTE_NAMESPACE}}             # block policies live beside the route they target
# Broken agent: its ModelConfig points at the 429 stub (demo/lab/broken-agent.yaml)
STUB_MODELCONFIG=demo-stub-429
STUB_URL=http://127.0.0.1:18085/v1/chat/completions
STUB_MODEL=demo-stub
# Approved fallback: any working ModelConfig; the probe must test the same model
FALLBACK_MODELCONFIG={{FALLBACK_MODELCONFIG}}
FALLBACK_URL={{FALLBACK_CHAT_COMPLETIONS_URL}}
FALLBACK_MODEL={{FALLBACK_MODEL}}
FALLBACK_KEY_CMD=                         # optional: a command that prints the fallback key (never the key itself)
# Lab port-forwards: namespace|service|local:remote, space separated
FORWARDS="kagent|kagent-controller|18083:8083 {{ROUTE_NAMESPACE}}|{{GATEWAY_SERVICE}}|18090:8080 guard-demo|model-stub|18085:8080"
