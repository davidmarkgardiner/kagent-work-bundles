{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/design/runtime-read-grant.schema.json",
  "title": "Proposed RuntimeGrantRecord data contract. Not a Kubernetes CRD.",
  "$defs": {
    "objectPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uid"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "revision",
    "state",
    "request",
    "subject",
    "caller",
    "capability",
    "scope",
    "operations",
    "limits",
    "notBefore",
    "expiresAt",
    "approval"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
      "maxLength": 253
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "Staged",
        "Active",
        "Revoked"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "namespaceUID",
        "name",
        "uid",
        "specSha256"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "namespaceUID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
          "maxLength": 253
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "specSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "hostedAgent",
        "agent",
        "serviceAccount",
        "hostedSpecSha256",
        "agentSpecSha256"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/objectPin"
        },
        "hostedAgent": {
          "$ref": "#/$defs/objectPin"
        },
        "agent": {
          "$ref": "#/$defs/objectPin"
        },
        "serviceAccount": {
          "$ref": "#/$defs/objectPin"
        },
        "hostedSpecSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "agentSpecSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "audience",
        "principal",
        "trustDomain",
        "mode",
        "identityProofSha256",
        "a2aProofSha256"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "trustDomain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mode": {
          "const": "namespaceAdminDomain"
        },
        "identityProofSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "a2aProofSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "operationContractSha256",
        "adapterImage",
        "backendProfileSha256"
      ],
      "properties": {
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "uid",
            "specSha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
              "maxLength": 253
            },
            "uid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "specSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "operationContractSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapterImage": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]+@sha256:[0-9a-f]{64}$"
        },
        "backendProfileSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "namespace"
      ],
      "properties": {
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "namespace": {
          "$ref": "#/$defs/objectPin"
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "get_deployment_health",
          "list_deployment_warning_summaries"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRows",
        "maxFieldCharacters",
        "maxEnvelopeBytes",
        "wholeCallSeconds",
        "maxClockUncertaintySeconds"
      ],
      "properties": {
        "maxRows": {
          "const": 50
        },
        "maxFieldCharacters": {
          "const": 512
        },
        "maxEnvelopeBytes": {
          "const": 32768
        },
        "wholeCallSeconds": {
          "const": 5
        },
        "maxClockUncertaintySeconds": {
          "const": 2
        }
      }
    },
    "notBefore": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gitCommit",
        "reviewerRef",
        "receiptSha256"
      ],
      "properties": {
        "gitCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receiptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
