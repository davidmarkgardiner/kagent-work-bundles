+func TestParseOptionsDetectorOnly(t *testing.T) {
+	for _, key := range []string{
+		"AGENTSHIELD_AGENTIC_INVESTIGATION", "AGENTSHIELD_DEPLOYMENT_RULE_AUTHORING",
+		"AGENTSHIELD_MODEL_ENDPOINT", "AGENTSHIELD_MODEL_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY",
+	} {
+		t.Setenv(key, "")
+	}
+	config, err := parseOptions([]string{"--detector-only"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !config.detectionEnabled() || config.agenticInvestigation || config.deploymentRuleAuthoring || config.modelEndpoint != "" || config.modelAPIKey != "" {
+		t.Fatal("detector-only must enable detection without a model feature, endpoint or key")
+	}
+	config, err = parseOptions(nil)
+	if err != nil || config.detectionEnabled() {
+		t.Fatalf("default detection enabled=%t, err=%v", config.detectionEnabled(), err)
+	}
+	for _, feature := range []string{"--agentic-investigation", "--deployment-rule-authoring"} {
+		if _, err := parseOptions([]string{"--detector-only", feature, "--model-endpoint=http://model.invalid"}); err == nil {
+			t.Fatalf("detector-only accepted %s", feature)
+		}
+	}
+	t.Setenv("AGENTSHIELD_AGENTIC_INVESTIGATION", "true")
+	if _, err := parseOptions([]string{"--detector-only"}); err == nil {
+		t.Fatal("detector-only accepted an environment-enabled model feature")
+	}
+}
