+func TestPostgreSQLDetectorOnlyStartsWithoutModelWorkers(t *testing.T) {
+	databaseURL := os.Getenv("AGENTSHIELD_TEST_DATABASE_URL")
+	if databaseURL == "" {
+		t.Skip("set AGENTSHIELD_TEST_DATABASE_URL to run PostgreSQL integration tests")
+	}
+	config := options{
+		detectorOnly: true, databaseURL: databaseURL, databaseMaxConns: 2,
+		detectionConsumer: "test/detector-only", detectionInterval: time.Second,
+		detectionSignalRetention: time.Hour, detectorReloadInterval: time.Second,
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	store, err := openStore(ctx, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	services, err := newDetectionServices(ctx, config, store)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if services.engine == nil || services.detection == nil {
+		t.Fatal("detector-only did not start the deterministic engine and detection service")
+	}
+	if services.investigation != nil || services.deploymentAuthor != nil {
+		t.Fatal("detector-only started a model worker")
+	}
+}
