{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "gated-noncompliant",
    "namespace": "policy-demo-noncompliant",
    "labels": {
      "lab.kyverno.io/fixture-intent": "noncompliant"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "containers": [
      {
        "name": "main",
        "image": "busybox:1.37.0",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "sh",
          "-c",
          "sleep 86400"
        ],
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "allowPrivilegeEscalation": true,
          "capabilities": {
            "add": [
              "SYS_ADMIN",
              "SYS_PTRACE",
              "NET_RAW"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          },
          "privileged": true
        },
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "8Mi"
          },
          "limits": {
            "cpu": "50m",
            "memory": "32Mi"
          }
        }
      }
    ],
    "schedulingGates": [
      {
        "name": "lab.kyverno.io/never-release"
      }
    ],
    "nodeSelector": {
      "lab.kyverno.io/never-schedule": "unmatched-fixture-20261101"
    },
    "hostPID": true,
    "hostIPC": true,
    "hostNetwork": true,
    "volumes": [
      {
        "name": "host",
        "hostPath": {
          "path": "/",
          "type": "Directory"
        }
      }
    ]
  }
}
