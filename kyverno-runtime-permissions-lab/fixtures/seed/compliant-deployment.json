{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "compliant-deployment",
    "namespace": "policy-demo-compliant"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "kyverno-lab-deployment"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "kyverno-lab-deployment"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "main",
            "image": "busybox:1.37.0",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "sleep 86400"
            ],
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "resources": {
              "requests": {
                "cpu": "5m",
                "memory": "8Mi"
              },
              "limits": {
                "cpu": "50m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    }
  }
}
