{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cluster-health/summary.schema.json",
  "title": "Cluster health summary ledger request",
  "type": "object",
  "required": ["cluster_id", "source_generation", "snapshot_seq", "body"],
  "properties": {
    "cluster_id": {"type": "string", "minLength": 1},
    "source_generation": {"type": "string", "minLength": 1},
    "snapshot_seq": {"type": "integer", "minimum": 1},
    "body": {
      "type": "object",
      "required": ["title", "labels", "source_checksum", "priorities", "problem_groups", "claims", "limitations", "external_delivery"],
      "properties": {
        "external_delivery": {"const": "disabled_lab_ledger"},
        "labels": {"type": "array", "minItems": 2, "uniqueItems": true}
      }
    }
  },
  "additionalProperties": false
}
