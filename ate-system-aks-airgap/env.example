# Copy to env.sh, fill in, never commit.
export KUBE_CONTEXT="{{AKS_CONTEXT}}"
export REGISTRY="{{ACR_NAME}}.azurecr.io"      # images, paths as in images.txt
export ASSETS_DIR="{{DIR_WITH_GVISOR_FILES}}"  # contains <release>/x86_64/gvisor.tar.zstd
export PG_STORAGE="32Gi"                       # development PostgreSQL disk
export STORAGE_CLASS=""                        # empty = cluster default
export AKS_ACR_PROVIDER="true"                 # mount the node's ACR credential provider into atelet
