+package main
+
+import (
+	"fmt"
+	"io"
+	"os/exec"
+	"strings"
+)
+
+const checkpointStderrLimit = 16 * 1024
+
+// stderrTail retains bounded diagnostic output while stderr continues to stream.
+type stderrTail struct {
+	data      []byte
+	truncated bool
+}
+
+func (b *stderrTail) Write(p []byte) (int, error) {
+	n := len(p)
+	if len(b.data)+n > checkpointStderrLimit {
+		b.truncated = true
+	}
+	if n >= checkpointStderrLimit {
+		b.data = append(b.data[:0], p[n-checkpointStderrLimit:]...)
+	} else {
+		excess := len(b.data) + n - checkpointStderrLimit
+		if excess > 0 {
+			b.data = b.data[excess:]
+		}
+		b.data = append(b.data, p...)
+	}
+	return n, nil
+}
+
+func runWithCheckpointDiagnostics(cmd *exec.Cmd) error {
+	var tail stderrTail
+	stream := cmd.Stderr
+	if stream == nil {
+		stream = io.Discard
+	}
+	cmd.Stderr = io.MultiWriter(stream, &tail)
+	if err := cmd.Run(); err != nil {
+		detail := strings.TrimSpace(string(tail.data))
+		if detail == "" {
+			detail = "<empty>"
+		}
+		qualifier := ""
+		if tail.truncated {
+			qualifier = " (truncated to last 16384 bytes)"
+		}
+		return fmt.Errorf("while running `runsc fscheckpoint`: %w; stderr%s: %s", err, qualifier, detail)
+	}
+	return nil
+}
