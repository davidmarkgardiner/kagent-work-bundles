+
+package main
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+)
+
+func TestCheckpointDiagnostics(t *testing.T) {
+	cmd := exec.Command("sh", "-c", "printf 'filesystem checkpoint saving failed: fixture\\n' >&2; exit 128")
+	var stream bytes.Buffer
+	cmd.Stderr = &stream
+	err := runWithCheckpointDiagnostics(cmd)
+	var exit *exec.ExitError
+	if !errors.As(err, &exit) || exit.ExitCode() != 128 {
+		t.Fatalf("exit cause lost: %v", err)
+	}
+	if !strings.Contains(err.Error(), "filesystem checkpoint saving failed: fixture") {
+		t.Fatal(err)
+	}
+	if !strings.Contains(stream.String(), "filesystem checkpoint saving failed: fixture") {
+		t.Fatal("stderr stream lost")
+	}
+	t.Log(err)
+}
+func TestCheckpointDiagnosticsSuccess(t *testing.T) {
+	if err := runWithCheckpointDiagnostics(exec.Command("sh", "-c", "exit 0")); err != nil {
+		t.Fatal(err)
+	}
+}
+func TestCheckpointDiagnosticsEmpty(t *testing.T) {
+	err := runWithCheckpointDiagnostics(exec.Command("sh", "-c", "exit 128"))
+	if err == nil || !strings.Contains(err.Error(), "stderr: <empty>") {
+		t.Fatal(err)
+	}
+}
+func TestStderrTail(t *testing.T) {
+	var tail stderrTail
+	for _, data := range [][]byte{bytes.Repeat([]byte("a"), checkpointStderrLimit-1), []byte("bc"), bytes.Repeat([]byte("z"), checkpointStderrLimit+10)} {
+		n, err := tail.Write(data)
+		if n != len(data) || err != nil || len(tail.data) > checkpointStderrLimit {
+			t.Fatal("invalid bounded write")
+		}
+	}
+	if !tail.truncated || !bytes.Equal(tail.data, bytes.Repeat([]byte("z"), checkpointStderrLimit)) {
+		t.Fatal("tail not retained")
+	}
+}
+
+// Optional real runsc negative test: nonexistent container, not the workplace workload.
+func TestRealRunscFatalDiagnostics(t *testing.T) {
+	path := os.Getenv("CHECKPOINT_DIAGNOSTICS_RUNSC")
+	if path == "" {
+		t.Skip("set CHECKPOINT_DIAGNOSTICS_RUNSC for Linux runtime check")
+	}
+	cmd := exec.Command(path, "--root", t.TempDir(), "fscheckpoint", "--image-path", t.TempDir(), "--path", "/data", "missing-fixture")
+	err := runWithCheckpointDiagnostics(cmd)
+	var exit *exec.ExitError
+	if !errors.As(err, &exit) || exit.ExitCode() != 128 || !strings.Contains(err.Error(), "loading container") {
+		t.Fatalf("unexpected diagnostic: %v", err)
+	}
+	t.Log(err)
+}
