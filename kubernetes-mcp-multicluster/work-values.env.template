# Copy to work-values.env and replace the environment-specific values.
# Use no quotes or spaces: this one file is read by both Bash and Kustomize.
# This file contains identifiers only. Never put tokens, kubeconfigs,
# passwords, client secrets, certificates, or connection strings here.

# Bootstrap kubeconfig contexts and stable aliases exposed to the Agent.
# Use comma-separated mappings.
HOST_CONTEXT={{MANAGEMENT_KUBECONFIG_CONTEXT}}
SOURCE_CONTEXTS={{SOURCE_CONTEXT_1}}={{STABLE_ALIAS_1}},{{SOURCE_CONTEXT_2}}={{STABLE_ALIAS_2}}
SMOKE_CONTEXTS={{STABLE_ALIAS_1}}={{UNIQUE_NODE_MARKER_1}},{{STABLE_ALIAS_2}}={{UNIQUE_NODE_MARKER_2}}

# Existing platform namespaces and gateway/model resources.
HOST_NAMESPACE=kubernetes-mcp-poc
KAGENT_NAMESPACE=kagent
AGENTGATEWAY_NAMESPACE=agentgateway-system
AGENTGATEWAY_NAME=ai-gateway
AGENTGATEWAY_SERVICE=ai-gateway
MODEL_CONFIG=default-model-config

# One canonical, comma-separated tool allowlist. This bundle currently
# requires exactly eight entries because Kustomize maps these fixed slots into
# the Agent and agentgateway policy as well as the Helm values.
TOOL_ALLOWLIST=events_list,namespaces_list,pods_get,pods_list,pods_list_in_namespace,pods_log,resources_get,resources_list

# The gateway URL is checked against AGENTGATEWAY_SERVICE and
# AGENTGATEWAY_NAMESPACE. The direct MCP host is derived by Kustomize.
AGENTGATEWAY_MCP_URL={{AGENTGATEWAY_KUBERNETES_MCP_URL}}

# Exactly twelve comma-separated egress CIDR slots. Use one approved target
# API address or aggregate network range per slot. Pad unused slots with
# 0.0.0.0/32. Never use 0.0.0.0/0 or ::/0.
TARGET_API_CIDRS={{TARGET_API_CIDR_1}},{{TARGET_API_CIDR_2}},{{TARGET_API_CIDR_3}},{{TARGET_API_CIDR_4}},{{TARGET_API_CIDR_5}},{{TARGET_API_CIDR_6}},{{TARGET_API_CIDR_7}},{{TARGET_API_CIDR_8}},{{TARGET_API_CIDR_9}},{{TARGET_API_CIDR_10}},{{TARGET_API_CIDR_11}},{{TARGET_API_CIDR_12}}

# Exactly four CIDR slots for the MCP pod's Entra Workload Identity token
# exchange. Prefer the approved egress proxy/Azure Firewall path and pad unused
# slots with 0.0.0.0/32. Default routes are rejected.
AZURE_IDENTITY_EGRESS_CIDRS={{IDENTITY_EGRESS_CIDR_1}},{{IDENTITY_EGRESS_CIDR_2}},{{IDENTITY_EGRESS_CIDR_3}},{{IDENTITY_EGRESS_CIDR_4}}

# The deployment must pull only from the approved internal registry.
IMAGE_REGISTRY={{INTERNAL_IMAGE_REGISTRY}}
IMAGE_REPOSITORY={{INTERNAL_IMAGE_REPOSITORY}}
IMAGE_VERSION={{INTERNAL_IMAGE_TAG}}
APPROVED_IMAGE_PREFIX={{INTERNAL_IMAGE_REGISTRY_OR_PROJECT_PREFIX}}
ALLOW_PUBLIC_IMAGE_FOR_TEST=0

# Extract the approved upstream GitHub archive inside the air-gapped
# environment and point CHART_REF at its chart directory. Use a path without
# spaces. No OCI chart pull is performed by this bundle.
CHART_REF={{LOCAL_KUBERNETES_MCP_CHART_DIRECTORY}}
CHART_VERSION=0.1.0
REPLICA_COUNT=1
RESOURCE_REQUEST_CPU=100m

# AKS-native refresh. Deploy one independently named bundle instance for each
# environment. The subscription list is an inventory boundary, not discovery
# across the entire tenant. Reuse the existing AKS-MCP UAMI and its already
# federated ServiceAccount for the Job. The Kubernetes MCP ServiceAccount needs
# a second federation because its subject is different.
AKS_CREDENTIAL_REFRESH_ENABLED=1
FLEET_ENVIRONMENT={{engineering_or_dev}}
AZURE_SUBSCRIPTION_IDS={{ENVIRONMENT_SUBSCRIPTION_ID_1}},{{ENVIRONMENT_SUBSCRIPTION_ID_2}}
AKS_MCP_WORKLOAD_NAMESPACE=aks-mcp
AKS_MCP_SERVICE_ACCOUNT=aks-mcp
AKS_MCP_UAMI_CLIENT_ID={{AKS_MCP_UAMI_CLIENT_ID}}
MCP_WORKLOAD_IDENTITY_SERVICE_ACCOUNT=kubernetes-mcp-fleet-workload-identity
MCP_NAME=kubernetes-mcp-fleet
KAGENT_AGENT_NAME=kubernetes-mcp-fleet-agent
REMOTE_MCP_NAME=kubernetes-mcp-fleet-gateway
AGENTGATEWAY_MCP_PATH=/mcp/kubernetes-mcp-fleet
KUBECONFIG_SECRET_NAME=kubernetes-mcp-fleet-kubeconfig
CREDENTIAL_REFRESH_NAME=kubernetes-mcp-credential-refresh
CREDENTIAL_REFRESH_CONFIG_NAME=kubernetes-mcp-credential-refresh-values
CREDENTIAL_REFRESH_SCRIPT_CONFIG_NAME=kubernetes-mcp-credential-refresh-script
CREDENTIAL_REFRESH_IMAGE={{INTERNAL_REGISTRY}}/{{PROJECT}}/aks-kubeconfig-refresh:{{TAG}}
CREDENTIAL_REFRESH_SUSPEND=false
CREDENTIAL_REFRESH_CRON_MINUTE=0
CREDENTIAL_REFRESH_CRON_HOUR=5

# Portable proof credentials only. Replace this flow with the documented
# Workload Identity/kubelogin design for the durable AKS implementation.
TOKEN_DURATION=24h
MIN_TOKEN_VALIDITY_SECONDS=82800
